/target
/desktop/gen
/desktop/node_modules
# API keys stay local (see .env.example)
.env
# Personal build settings (see .cargo/config.toml.example)
/.cargo/config.toml

# Locally installed agent skills (reinstall from skills-lock.json)
/.agents/
/.claude/
# Impeccable's generated reference boards
/.impeccable/reference/
/supabase/tests/node_modules
# Website build output (python site/build.py)
/_site/
__pycache__/

# Other tools' working folders: never part of the repo
/.worktrees/

# The knowledge graph (graphify-out/) is committed; only what is specific to one PC is not:
# its interpreter and scan-root paths, and the extraction cache.
/graphify-out/.graphify_python
/graphify-out/.graphify_root
/graphify-out/cache/

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "freetime",
  "version": "0.4.1",
  "identifier": "dev.freetime.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "freetime",
        "width": 1280,
        "height": 860,
        "minWidth": 940,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https://i.ytimg.com https://*.steamstatic.com https://*.epicgames.com https://*.unrealengine.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "freetime",
    "copyright": "MIT license",
    "category": "Lifestyle",
    "shortDescription": "Find the best thing to do with your free time",
    "longDescription": "freetime picks the best thing to do with the time you have: a game you own, a video, a sport, a recipe, something new, alone or with friends.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3RDc3N0IzOERFRkQwRDAKUldUUTBPK05zM2ZYOXhwcVdrem41TDE3V3dRUk1Vd3ZkeHVLVitzdmU0OXFiTkRJK3o5cEVVNisK",
      "endpoints": ["https://github.com/osmvision/freetime/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}

# Optional API keys. Copy this file to .env and fill in what you have.
# freetime works without them: they only make picks more personal.
#
# Steam Web API key: https://steamcommunity.com/dev/apikey
#   Lists every game you own, with playtime (backlog, old favorites).
STEAM_API_KEY=
# YouTube Data API v3 key: https://console.cloud.google.com/apis/library/youtube.googleapis.com
#   Searches videos that match your interests and fit your free time.
YOUTUBE_API_KEY=

# Optional API keys. Copy this file to .env and fill in what you have.
# freetime works without them: they only make picks more personal.
# Keys are read at runtime and never compiled into the app (unless you build with
# --features freetime-core/embed-keys, for a personal build that never leaves your PC).
#
# Steam Web API key: https://steamcommunity.com/dev/apikey
#   Lists every game you own, with playtime (backlog, old favorites).
STEAM_API_KEY=
# YouTube Data API v3 key: https://console.cloud.google.com/apis/library/youtube.googleapis.com
#   Searches videos that match your interests and fit your free time.
YOUTUBE_API_KEY=
# Mistral AI API key: https://console.mistral.ai/api-keys
#   Turns on the chat assistant (the bubble at the bottom right). Only your messages and a
#   short context (weather, mood, interests, current picks) are sent, only when you write.
MISTRAL_API_KEY=
